{
  "name": "simple-notion-orm",
  "version": "0.1.0",
  "description": "Simple TypeScript ORM helpers for Notion's Data Sources API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "notion",
    "orm",
    "notion-api",
    "notion-database"
  ],
  "author": "Abhin Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinsharma/simple-notion-orm.git"
  },
  "bugs": {
    "url": "https://github.com/abhinsharma/simple-notion-orm/issues"
  },
  "homepage": "https://github.com/abhinsharma/simple-notion-orm#readme",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsc-alias": "1.9.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
