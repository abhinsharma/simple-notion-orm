{
  "name": "simple-notion-orm",
  "version": "0.1.0",
  "description": "Simple TypeScript ORM helpers for Notion's Data Sources API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "notion",
    "orm",
    "notion-api",
    "notion-database"
  ],
  "author": "Abhin Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinsharma/simple-notion-orm.git"
  },
  "bugs": {
    "url": "https://github.com/abhinsharma/simple-notion-orm/issues"
  },
  "homepage": "https://github.com/abhinsharma/simple-notion-orm#readme",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && pnpm run clean:dist",
    "clean:dist": "rimraf dist/src dist/tests dist/playground.* dist/vitest.config.*",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsc-alias": "1.9.7",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.0",
    "dotenv": "^18.0.7",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
